# Server
PORT=3000
FIREBASE_PROJECT_ID=medplant-scanner
# Preferred in production:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"medplant-scanner",...}

# PostgreSQL (Neon)
# Example: postgres://alex:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_1mfPNdDKUaC4@ep-silent-union-akt4bbrv-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# PlantNet API
# Get your free key at: https://my.plantnet.org/account/doc
PLANTNET_API_KEY=your_plantnet_api_key_here

# Confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.20

# Admin dashboard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_TOKEN_SECRET=replace_with_a_long_random_secret

# Email delivery for /admin/send-email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@example.com
SMTP_PASS=replace_with_smtp_password
EMAIL_FROM="MedPlant Scanner <admin@example.com>"

# Image upload limits
MAX_IMAGE_SIZE_MB=10



CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ACCESS_KEY_ID
CLOUDFLARE_SECRET_ACCESS_KEY
CLOUDFLARE_BUCKET_NAME
CLOUDFLARE_PUBLIC_DOMAIN
